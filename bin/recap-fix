#!/usr/bin/env bash
# recap-fix — run a security row's dependency fix, interactively.
#
#   recap-fix <repo-path> <npm|pnpm> <package> [advisory title]
#
# Invoked by `recap fix --term` inside a kitty window. It exists as a real
# script rather than a generated one-liner so it can *ask* before escalating:
# the safe pass rarely clears transitive advisories, and the next step (pinning
# via overrides, or taking a major bump) is a judgement call that should be
# yours, made with the audit output in front of you.
#
# Never commits. Never escalates without you choosing it.
set -uo pipefail

REPO=${1:?repo path required}
TOOL=${2:?npm or pnpm required}
PKG=${3:-}
TITLE=${4:-}

cd "$REPO" || { echo "recap-fix: cannot cd to $REPO"; exit 1; }

MANIFESTS=(package.json package-lock.json pnpm-lock.yaml pnpm-workspace.yaml)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }

audit_summary() {
    if [ "$TOOL" = pnpm ]; then pnpm audit < /dev/null 2>&1; else npm audit < /dev/null 2>&1; fi \
        | grep -E "^[0-9]+ vulnerabilit|^found [0-9]+|Severity:" | tail -2
}

remaining() {
    # Must print exactly one integer. Two traps here:
    #  * `npm audit`/`pnpm audit` exit non-zero whenever vulnerabilities exist,
    #    so under `pipefail` a trailing `|| echo 0` fires *in addition to* the
    #    real count — the caller then sees "22\n0", the numeric test errors,
    #    and the menu loops forever.
    #  * the two tools disagree on shape: npm keys by package under
    #    `vulnerabilities`, pnpm reports counts under `metadata.vulnerabilities`
    #    and its findings under `advisories`. Parse both rather than grepping.
    local out n
    if [ "$TOOL" = pnpm ]; then
        out=$(pnpm audit --json < /dev/null 2>/dev/null) || true
    else
        out=$(npm audit --json < /dev/null 2>/dev/null) || true
    fi
    n=$(printf '%s' "$out" | python3 -c 'import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print(0); raise SystemExit
v = d.get("vulnerabilities")
if isinstance(v, dict) and v and not isinstance(next(iter(v.values())), int):
    print(len(v)); raise SystemExit          # npm: keyed by package
adv = d.get("advisories")
if isinstance(adv, dict) and adv:
    print(len(adv)); raise SystemExit        # pnpm: keyed by advisory id
counts = ((d.get("metadata") or {}).get("vulnerabilities") or {})
print(sum(c for k, c in counts.items() if k != "info" and isinstance(c, int)))' 2>/dev/null) || n=0
    case "$n" in (''|*[!0-9]*) n=0 ;; esac
    printf '%s' "$n"
}

changes() {
    git status --short -- "${MANIFESTS[@]}" 2>/dev/null
}

show_state() {
    echo
    bold "--- manifest changes (nothing committed) ---"
    local c; c=$(changes)
    [ -n "$c" ] && echo "$c" || dim "(none)"
    echo
    bold "--- advisories left ---"
    audit_summary
    echo
}

run() {
    echo
    bold "\$ $*"
    # stdin from /dev/null: npm/pnpm/git will happily consume the menu's
    # keystrokes otherwise, and the next `read` then sees whatever is left —
    # which silently skips the choice you actually typed.
    "$@" < /dev/null
    local rc=$?
    echo
    return $rc
}

build_check() {
    if ! grep -q '"build"' package.json 2>/dev/null; then
        warn "no build script in package.json — skipping"
        return
    fi
    if run "$TOOL" run build; then
        bold "build OK"
    else
        warn "BUILD FAILED — consider: git checkout -- ${MANIFESTS[*]}"
    fi
}

pkg_version() {
    python3 - "$1" <<'PYVER' 2>/dev/null || true
import json, sys
try:
    d = json.load(open("package.json"))
except Exception:
    sys.exit()
allv = {**(d.get("dependencies") or {}), **(d.get("devDependencies") or {})}
v = allv.get(sys.argv[1] or "")
print(v.lstrip("^~") if v else "")
PYVER
}

commit_message() {
    local after=$1 cleared ver
    cleared=$(( BEFORE - after ))
    [ "$cleared" -lt 0 ] && cleared=0
    ver=$(pkg_version "$PKG")
    if [ -n "$PKG" ] && [ -n "$ver" ] && [ "$cleared" -gt 0 ]; then
        echo "Bumps $PKG to $ver to clear $cleared advisories"
    elif [ "$cleared" -gt 0 ]; then
        echo "Fixes $cleared dependency advisories"
    else
        echo "Updates dependencies for security advisories"
    fi
}

commit_and_push() {
    local c; c=$(changes)
    [ -z "$c" ] && { warn "nothing to commit"; return; }
    local msg; msg=$(commit_message "$(remaining)")
    echo
    bold "commit these manifest files only:"
    echo "$c"
    dim "  message: $msg"
    echo
    read -rp "commit? [Y]es / [e]dit message / [n]o: " a
    case "$a" in
        n|N) return ;;
        e|E) read -rp "message: " m; [ -n "$m" ] && msg="$m" ;;
    esac
    # Stage only the manifests that actually changed: passing a pathspec that
    # matches nothing (package-lock.json in a pnpm repo) makes git reject the
    # whole `add` and stage nothing at all.
    local -a files=()
    while IFS= read -r line; do
        [ -n "$line" ] && files+=("${line:3}")
    done < <(changes)
    [ ${#files[@]} -eq 0 ] && { warn "nothing to stage"; return; }
    run git add -- "${files[@]}"
    if ! run git commit -m "$msg"; then
        warn "commit failed"; return
    fi
    local up; up=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)
    if [ -z "$up" ]; then
        warn "no upstream branch — committed but not pushed"; return
    fi
    read -rp "push to $up? [Y/n]: " p
    case "$p" in n|N) dim "not pushed"; return ;; esac
    run git push
}

bold "recap fix · $(basename "$REPO")  ($PKG)"
[ -n "$TITLE" ] && dim "advisory: $TITLE"
if [ "$TOOL" = pnpm ]; then
    dim "scope:    pnpm updates package.json + lockfile and installs"
else
    dim "scope:    npm touches the lockfile only, no install"
fi
dim "nothing is committed at any point"

BEFORE=$(remaining)

dirty=$(changes)
[ -n "$dirty" ] && { echo; warn "!! these already had uncommitted changes:"; echo "$dirty"; }

# --- pass 1: the safe fix -------------------------------------------------
if [ "$TOOL" = pnpm ]; then
    run pnpm audit --fix=update
else
    run npm audit fix --package-lock-only
fi
show_state

# --- escalation menu ------------------------------------------------------
while true; do
    left=$(remaining)
    case "$left" in (''|*[!0-9]*) left=0 ;; esac
    if [ "$left" -eq 0 ]; then
        bold "clean — no advisories left"
        break
    fi
    bold "$left advisories remain (transitive, or needing a major bump)"
    cat <<'MENU'

  o  pin transitive deps      pnpm: audit --fix=override   npm: audit fix --force
  m  major bump this package  update it to latest, across majors
  M  major bump everything    every dependency to its latest major
  b  build check              run the build script and report
  s  status                   re-show changes and remaining advisories
  c  commit + push            manifest files only, generated message
  r  revert                   git checkout the manifest files
  q  quit                     leave changes in the working tree

MENU
    read -rp "choice [o/m/M/b/c/s/r/q]: " choice
    case "$choice" in
        o)  if [ "$TOOL" = pnpm ]; then
                run pnpm audit --fix=override
                # `--fix=override` only *writes* the overrides — pnpm itself
                # says "Run pnpm install to apply the fixes". Without this the
                # lockfile never moves and the advisory count looks unchanged,
                # which reads as "override did nothing".
                run pnpm install
            else
                run npm audit fix --force
            fi
            show_state
            warn "overrides can pin across majors (e.g. next 14 -> 15) — press b to build-check" ;;
        m)  [ -z "$PKG" ] && { warn "no package on this row"; continue; }
            if [ "$TOOL" = pnpm ]; then run pnpm update --latest "$PKG"
            else run npm install "$PKG@latest"; fi
            show_state
            warn "a major bump landed — press b to build-check" ;;
        M)  warn "this takes every dependency across major versions — expect breakage"
            read -rp "sure? [y/N]: " ok
            [ "$ok" = y ] || continue
            if [ "$TOOL" = pnpm ]; then run pnpm update --latest
            else run npx --yes npm-check-updates -u && run npm install; fi
            show_state
            warn "everything moved across majors — press b to build-check" ;;
        b)  build_check ;;
        c)  commit_and_push ;;
        s)  show_state ;;
        r)  run git checkout -- "${MANIFESTS[@]}"
            bold "reverted"; show_state ;;
        q|"") break ;;
        *)  warn "unknown choice: $choice" ;;
    esac
done

echo
c=$(changes)
if [ -n "$c" ]; then
    bold "uncommitted manifest changes:"
    echo "$c"
    commit_and_push
else
    dim "no manifest changes"
fi

# Re-derive the security section so a cleared row leaves the digest. Only this
# repo gets re-audited — the others stay cached, keyed on lockfile mtime.
RECAP="$(dirname "$(dirname "$(realpath "$0")")")/recap"
if [ -x "$RECAP" ]; then
    dim "refreshing recap…"
    "$RECAP" refresh --quiet --only security < /dev/null >/dev/null 2>&1 &
fi

echo
read -rp "[enter] to close "
